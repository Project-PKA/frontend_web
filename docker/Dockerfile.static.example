# =============================================================================
# EXEMPLO — build estatico servido por nginx.
# Copie para a raiz como `Dockerfile` e substitua os TODO.
#
#   docker build -t meu-frontend --build-arg API_BASE_URL=https://api.exemplo.com .
#   docker run --rm -p 8081:8080 meu-frontend
#
# ATENCAO: as variaveis abaixo sao embutidas no bundle em tempo de BUILD.
# Uma imagem gerada com a URL de homologacao NAO pode ser promovida para
# producao. Ver docker/README.md.
# =============================================================================

# ---------- Etapa 1: dependencias ----------
# TODO: troque a imagem base pelo runtime da stack (node, bun, deno...).
FROM node:22-alpine AS deps
WORKDIR /app
# TODO: copie os manifestos da stack (package.json + lockfile, deno.json...).
COPY package.json package-lock.json* ./
# TODO: comando de instalacao reprodutivel — o mesmo de SETUP_CMD.
RUN npm ci --no-audit --no-fund

# ---------- Etapa 2: build ----------
FROM node:22-alpine AS build
WORKDIR /app

# TODO: ajuste os nomes ao prefixo da stack (VITE_, NEXT_PUBLIC_, PUBLIC_...).
ARG API_BASE_URL
ARG APP_ENV=prod
ENV API_BASE_URL=$API_BASE_URL APP_ENV=$APP_ENV

COPY --from=deps /app/node_modules ./node_modules
COPY . .
# TODO: comando de build — o mesmo de BUILD_CMD.
RUN npm run build

# ---------- Etapa 3: runtime ----------
# Imagem unprivileged: roda como uid 101 e escuta em 8080, sem root.
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

COPY docker/nginx.conf.example /etc/nginx/conf.d/default.conf
# TODO: ajuste a origem ao BUILD_DIR do project.mk (dist, build, out...).
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --spider http://localhost:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
