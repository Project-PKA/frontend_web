# =============================================================================
# Variaveis de ambiente — copie para `.env.local` e ajuste.
#
# REGRAS QUE NAO DEPENDEM DA STACK
#
#  1. Em frontend NAO EXISTE segredo. Tudo que vai para o bundle e publico,
#     independentemente do nome da variavel. Chave de API privada, senha e
#     token de servico ficam no backend — sem excecao.
#
#  2. Cada framework tem um prefixo que marca "isto vai para o browser":
#       Vite       VITE_
#       Next.js    NEXT_PUBLIC_
#       Nuxt       NUXT_PUBLIC_
#       Astro      PUBLIC_
#       CRA        REACT_APP_
#     Ajuste os nomes abaixo ao prefixo da stack escolhida.
#
#  3. Na maioria das builds de frontend a variavel e resolvida em TEMPO DE
#     BUILD: o valor fica gravado no artefato. Isso significa que um build
#     nao pode ser promovido de homologacao para producao — cada ambiente
#     refaz o build. Para "build once / deploy many", a configuracao
#     precisa ser lida em runtime (ex.: um /config.json servido junto).
#     Registre a decisao em ARCHITECTURE.md.
#
#  4. Toda variavel nova precisa estar em TRES lugares: aqui, na leitura
#     validada de ambiente do codigo, e nas variables do GitHub Environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime da aplicacao
# -----------------------------------------------------------------------------

# URL base da API consumida pelo frontend. Sem barra no final.
API_BASE_URL=http://localhost:8080

# Ambiente logico: local | dev | test | homolog | prod
# Usado para telemetria, feature flags e banner de ambiente nao-produtivo.
APP_ENV=local

# URL publica desta aplicacao. Usada em metadados e no smoke test do deploy.
APP_BASE_URL=http://localhost:5173

# Liga logs verbosos. Sempre `false` em producao.
ENABLE_DEBUG=true

# -----------------------------------------------------------------------------
# Ferramentas (nao vao para o browser)
# -----------------------------------------------------------------------------

# Contrato de API usado por `make generate-types`.
# Aceita caminho local ou URL. O contrato e publicado pelo BACKEND —
# nao mantenha uma copia neste repositorio.
OPENAPI_SPEC=

# URL base para a suite e2e rodar contra um ambiente ja publicado.
# Vazio: o e2e sobe o preview local.
E2E_BASE_URL=

# -----------------------------------------------------------------------------
# Somente CI/CD — configure como GitHub Secrets/Variables, nunca em arquivo
# -----------------------------------------------------------------------------
# Nomes canonicos: CONVENCOES.md do codex-base, secao 11.
#
# AUTOMATION_TOKEN       (secret, org)         Project, release, PRs de contrato
# SONAR_TOKEN            (secret, org)         token do SonarCloud
# PROJECT_URL            (variable, org)       URL do GitHub Project
# CONTRACT_REPO          (variable, org)       org/repo do docs/shared
# CODEQL_LANGUAGES       (variable, repo)      linguagens do CodeQL
# COVERAGE_THRESHOLD     (variable, repo)      meta exibida no comentario de PR
#
# Por environment (dev / test / homolog / prod):
# APP_BASE_URL           (variable)            URL publica do ambiente
# API_BASE_URL           (variable)            API daquele ambiente
# DEPLOY_TOKEN           (secret)              credencial da plataforma
# + o que scripts/deploy.sh exigir — ver DEPLOY.md

# Origem publica do site (ex.: https://example.com), sem barra final. Usada no
# build para gerar canonical e hreflang da landing. Resolvida em BUILD, nao em
# runtime. Vazio: os links absolutos nao sao gerados.
SITE_URL=
